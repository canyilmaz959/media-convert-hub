<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Dosya Format Dönüştürücü</title>
    <style>
        input[type="file"], select {
            width: 100%; padding: 0.8rem 1rem; background-color: var(--bg-color);
            border: 1px solid var(--border-color); border-radius: 8px;
            color: var(--text-main); box-sizing: border-box; font-size: 0.95rem; cursor: pointer;
        }
        input[type="file"]:focus, select:focus { outline: none; border-color: var(--accent-color); }
        .flex-group { display: flex; gap: 1rem; }
        .flex-item { flex: 1; }
    </style>
</head>
<body>

    <div class ="container">
        <div style="margin-bottom : 1.5rem;">
            <a href="/" style="color: var(--text-muted); font-size: 0.9rem;"><i class="fa-solid fa-arrow-left"></i> Ana Panel</a>
        </div>

    <div class ="card">

        <div id="loading-overlay" class="overlay hidden">
            <div class="spinner"></div>
            <h3 class="overlay-title">Belgeniz İşleniyor...</h3>
            <p class="overlay-desc">Lütfen bekleyin, veri işleniyor ve format dönüştürülüyor.</p>
        </div>

        <h2 class="title text-center">Dosya Format Dönüştürücü</h2>
        <p class="subtitle text-center">Dosyanızı seçin, hedef formatı belirleyin ve anında indirin.</p>

        <form action="/dosya/convert" method="POST" enctype="multipart/form-data" id="convertForm">
            <div class="form-group">
                <label for="fileInput">Yüklenecek Dosya (PDF, DOCX, POTX, ODP, PPTX):</label>
                <input type="file" name="document" id="fileInput" required accept=".pdf,.docx,.potx,.odp,.pptx">
            </div>

            <div class="flex-group form-group">
                <div class="flex-item">
                    <label for="fromFormat">Mevcut Format:</label>
                    <input type="text" name="fromFormat" id="fromFormat" readonly placeholder="Dosya bekleniyor..." style="background-color: rgba(255,255,255,0.05); color: var(--text-muted); cursor: not-allowed; text-transform: uppercase; font-weight: bold;">
                </div>

                <div class="flex-item">
                    <label for="toFormat">Hedef Format:</label>
                    <select name="toFormat" id="toFormat" required>
                        <option value="pdf">PDF</option>
                        <option value="docx">DOCX</option>
                        <option value="potx">POTX</option>
                        <option value="odp">ODP</option>
                        <option value="pptx">PPTX</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn"><i class="fa-solid fa-file-export"></i>Dönüştür ve İndir</button>
        </form>
    </div>
    </div>

    <footer>&copy; 2026 Çevrimiçi Medya Dönüştürme Platformu.</footer>


<script>
    const fileInput = document.getElementById('fileInput');
    const fromFormatSelect = document.getElementById('fromFormat');
    const toFormatSelect = document.getElementById('toFormat');

    fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file){
            fromFormatSelect.value = '';
            return;
        }

        const fileName = file.name.toLowerCase().trim();
        let fileExtension = fileName.split('.').pop().trim();

        fromFormatSelect.value = fileExtension;
        console.log(`Yüklenen dosya: ${fileName}, Uzantı: ${fileExtension}`);

        if (fromFormatSelect.value === toFormatSelect.value) {
            if(fileExtension === "pdf") {
                toFormatSelect.value = 'docx';
            } else {
                toFormatSelect.value = 'pdf';
            }
        }

    });
    

    document.getElementById('convertForm').addEventListener('submit', function(e) {
        const fromFmt = document.getElementById('fromFormat').value;
        const toFmt = document.getElementById('toFormat').value;

        if (fromFmt === toFmt) {
            e.preventDefault();
            alert('Mevcut format ve hedef format aynı olamaz. Lütfen farklı bir hedef format seçin.');
            return;
        }

        document.getElementById('loading-overlay').classList.remove('hidden');
        const btn = this.querySelector('button[type="submit"]');
        if(btn){
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> İşleniyor...';    
        }
    });


</script>
</body>
</html>