<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f172a">
    <title>Oops! Bir şeyler ters gitti | Medya İşlem Merkezi</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .error-page {
            flex: 1;
            display: grid;
            place-items: center;
            padding: 2rem 1rem;
            position: relative;
            isolation: isolate;
            overflow: hidden;
        }
        .error-page::before,
        .error-page::after {
            content: "";
            position: absolute;
            z-index: -1;
            width: 22rem;
            height: 22rem;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.16;
            pointer-events: none;
        }
        .error-page::before {
            background: #6366f1;
            top: -12rem;
            right: -7rem;
        }
        .error-page::after {
            background: #818cf8;
            bottom: -14rem;
            left: -8rem;
        }
        .error-card {
            width: min(100%, 560px);
            text-align: center;
            padding: clamp(2rem, 6vw, 3.5rem);
        }
        .error-mark {
            width: 5.25rem;
            height: 5.25rem;
            display: grid;
            place-items: center;
            margin: 0 auto 1.5rem;
            border: 1px solid rgba(129, 140, 248, 0.35);
            border-radius: 24px;
            color: #a5b4fc;
            background: linear-gradient(145deg, rgba(99, 102, 241, 0.22), rgba(99, 102, 241, 0.06));
            box-shadow: 0 14px 40px rgba(79, 70, 229, 0.18);
            transform: rotate(-5deg);
        }
        .error-mark svg { width: 2.6rem; height: 2.6rem; }
        .error-eyebrow {
            margin: 0 0 0.65rem;
            color: #a5b4fc;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }
        .error-heading {
            margin: 0 0 0.75rem;
            font-size: clamp(2.6rem, 9vw, 4rem);
            line-height: 1;
            background: linear-gradient(135deg, #c7d2fe 0%, #818cf8 55%, #6366f1 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .error-description {
            max-width: 390px;
            margin: 0 auto 1.75rem;
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.7;
        }
        .error-actions {
            display: flex;
            justify-content: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        .error-actions .btn {
            width: auto;
            min-width: 175px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.55rem;
            padding: 0.85rem 1.1rem;
            box-sizing: border-box;
        }
        .error-home {
            color: var(--text-main);
            background: rgba(148, 163, 184, 0.1);
            border: 1px solid var(--border-color);
        }
        .error-home:hover { background: rgba(148, 163, 184, 0.17); }
        .error-reference {
            margin: 1.5rem 0 0;
            color: #64748b;
            font-size: 0.78rem;
        }
        @media (max-width: 420px) {
            .error-actions { flex-direction: column; }
            .error-actions .btn { width: 100%; }
        }
        @media (prefers-reduced-motion: no-preference) {
            .error-card { animation: error-appear 450ms ease-out both; }
            @keyframes error-appear {
                from { opacity: 0; transform: translateY(12px); }
                to { opacity: 1; transform: translateY(0); }
            }
        }
    </style>
</head>
<body>
    <main class="error-page">
        <section class="card error-card" aria-labelledby="error-title">
            <div class="error-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 8v5m0 3.5h.01M10.3 3.9 2.7 17.1A2 2 0 0 0 4.4 20h15.2a2 2 0 0 0 1.7-2.9L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <p class="error-eyebrow">Medya İşlem Merkezi</p>
            <h1 class="error-heading" id="error-title">Oops!</h1>
            <p class="error-description"><%= typeof message !== 'undefined' && message ? message : 'Bir şeyler ters gitti. İşleminiz tamamlanamadı. Lütfen tekrar deneyin.' %></p>
            <div class="error-actions">
                <a class="btn" href="<%= typeof retryUrl !== 'undefined' && retryUrl ? retryUrl : '/' %>">
                    <span aria-hidden="true">↻</span> Tekrar Dene
                </a>
                <a class="btn error-home" href="/">
                    <span aria-hidden="true">⌂</span> Ana Sayfaya Dön
                </a>
            </div>
            <p class="error-reference">Dosyalarınız güvende. İsterseniz yeni bir işlem başlatabilirsiniz.</p>
        </section>
    </main>
    <footer>&copy; 2026 Çevrimiçi Medya Dönüştürme Platformu.</footer>
</body>
</html>
